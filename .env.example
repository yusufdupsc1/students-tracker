# ============================================
# Students Tracker – Environment Variables
# Copy to .env.local and fill values
# All VITE_ vars are exposed to the browser (public)
# ============================================

# --- Supabase (Required) ---
# Get from: https://supabase.com/dashboard/project/hzgaflrabmrcsokhoatv/settings/api
VITE_SUPABASE_URL=https://hzgaflrabmrcsokhoatv.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For server-side admin ops (seed, password reset) – keep SECRET, never expose to client
# Found in Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Alternative name used in CI
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Admin Seed (for scripts/seed-admin.mjs & reset-credentials.mjs) ---
ADMIN_EMAIL=yusufdupsc1@gmail.com
ADMIN_PASSWORD=Bejkhonda@2025!Secure
ADMIN_SCHOOL_NAME=বেজখণ্ড সঃ প্রাঃ বিদ্যালয়

# --- Vercel Blob Remote Sync (optional) ---
ADMIN_TOKEN=change-me-to-a-random-secret
VITE_ADMIN_TOKEN=change-me-to-a-random-secret

# --- Vercel Deployment (CI) ---
# Get from Vercel Dashboard → Settings → Tokens / Project Settings
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Supabase Migrations (CI) ---
SUPABASE_PROJECT_ID=hzgaflrabmrcsokhoatv
SUPABASE_ACCESS_TOKEN=

# --- Notes ---
# - VITE_SUPABASE_ANON_KEY is public (anon) – safe to expose, protected by RLS
# - Never commit .env.local – it's gitignored
# - For local dev: npm run dev will use fallback URL if env missing, but auth will fail without anon key
# - After setting env, run: npm run verify  (typecheck + tests + build)
# - To reset credentials locally: npm run seed:admin  or  node scripts/reset-credentials.mjs --password="NewPass123!"
